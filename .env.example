# Artists Farm - Environment Configuration
# Copy this to .env and fill in your actual values
# NEVER commit the .env file - add it to .gitignore

# API Authentication
API_KEY=your_secure_random_key_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Group IDs (for local development)
TELEGRAM_KITCHEN_CHAT_ID=-5511705268
TELEGRAM_ADMIN_CHAT_ID=-5362212071
TELEGRAM_FINANCE_CHAT_ID=-5511705268

# Telegram Group IDs (for production - use different groups)
# Uncomment and update for production environment
# TELEGRAM_KITCHEN_CHAT_ID=-5456387701
# TELEGRAM_ADMIN_CHAT_ID=-5415746187
# TELEGRAM_FINANCE_CHAT_ID=-5303969309

# Database Configuration (if needed)
# DB_HOST=localhost
# DB_USER=root
# DB_PASS=
# DB_NAME=artists_farm

# Application Environment
# APP_ENV=production
# APP_DEBUG=false
