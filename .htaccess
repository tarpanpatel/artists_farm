# The server's default DirectoryIndex order favors index.html over index.php,
# so requests to / were serving the raw Vite SOURCE template (script src=
# "/src/main.tsx", never transpiled in production) instead of routing to
# index.php, which injects tenant/property slugs and serves dist/index.html.
# Result: a blank page with just the <title> visible, nothing ever mounts.
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Was "/artists_farm/" - a subfolder this site has never actually been
    # deployed under (served from the domain root on ground-code.com; was
    # artistic-sthan.com before the 24 Aug 2026 domain migration).
    RewriteBase /

    # Short, shareable URL for the public sales demo - plain redirect (URL bar
    # updates to the real property URL), not a rewrite/cloak.
    RewriteRule ^demo/?$ /rivera-resorts/luxe-stays/ [R=302,L]

    # Public, no-login "Share Menu" link (food_menu.php) - deliberately BEFORE
    # the generic tenant/property routing rules below. Those match ANY first
    # path segment (food_menu included) and always win once they hit [L], so
    # with this block placed after them (as it used to be) /food_menu/... was
    # unreachable - it always resolved to index.php?property_slug=food_menu
    # instead, loading the React SPA rather than this page (found 21 Aug 2026
    # while wiring up the Share Menu button; the single-segment fallback rule
    # has no /php-style "real file" carve-out for food_menu.php the way static
    # assets get, since the request path itself never has a .php extension).
    RewriteRule ^food_menu/([a-z0-9-_]+)/?$ food_menu.php?property_slug=$1 [QSA,L]
    RewriteRule ^food_menu/?$ food_menu.php [QSA,L]

    # Public, no-login "Share Availability" link (availability.php)
    RewriteRule ^availability/([a-z0-9-_]+)/?$ availability.php?property_slug=$1 [QSA,L]
    RewriteRule ^availability/?$ availability.php [QSA,L]

    # Favicon and App Icons: route any subpath requests (e.g. /jaipur/favicon.ico or /jaipur/app-icons/...)
    # to the actual root static files so browsers receive the real image rather than an HTML SPA rewrite.
    RewriteRule (^|.*/)(favicon\.ico)$ /favicon.ico [L]
    RewriteRule (^|.*/)(app-icons/.+)$ /$2 [L]

    # Handle tenant/property routing for multi-tenant SaaS
    # e.g., /tenant-slug/property-slug/anything -> /index.php?tenant_slug=tenant-slug&property_slug=property-slug
    # Only rewrites when the full path isn't a real file/directory, so
    # /php/..., /dist/..., /assets/..., /api/... etc. are left untouched -
    # EXCEPT that comment was only half true (found 22 Aug 2026, reported as
    # a "Kitchen Management Error" / "'text/html' is not a valid JavaScript
    # MIME type" crash): !-f/!-d only bail out for a file that STILL exists.
    # A hashed chunk from a deploy that has since shipped a new hash (dist/
    # assets/KitchenManagement-<oldhash>.js, deleted by the new build) no
    # longer exists on disk, so those conditions both pass and this rule
    # rewrote it into index.php?tenant_slug=dist&property_slug=assets - a 200
    # HTML response where the browser's dynamic import() expected JS. Any
    # tab/PWA left open across a deploy would then throw exactly that MIME-
    # type error the next time it lazy-loaded a route it hadn't visited yet
    # in that session. The explicit REQUEST_URI exclusion below is what
    # actually makes a missing /dist/ file 404 for real instead.
    RewriteCond %{REQUEST_URI} !clean_all_roberts\.php$
    RewriteCond %{REQUEST_URI} !^/dist/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z0-9-_]+)/([a-z0-9-_]+)/?(.*)$ index.php?tenant_slug=$1&property_slug=$2 [QSA,L]

    # Fallback for single segment (tenant dashboard)
    RewriteCond %{REQUEST_URI} !clean_all_roberts\.php$
    RewriteCond %{REQUEST_URI} !^/dist/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z0-9-_]+)/?(.*)$ index.php?property_slug=$1 [QSA,L]
</IfModule>

# Browser HTTP Asset Caching (Strategy 1)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # index.html (and any other root HTML entry point) must NEVER inherit the
    # 1-month ExpiresDefault above - found 23 Aug 2026 while chasing a
    # deploy-panel "Staging bundle mismatch!" false failure: mod_expires was
    # setting Cache-Control: public, max-age=2592000 on index.html itself
    # (confirmed via curl on staging) purely because nothing overrode the
    # default for text/html. index.html is the ONE file whose entire job is
    # to always point at the CURRENT content-hashed bundle filenames
    # (index-XXXX.js/css) - caching it for a month means a returning
    # visitor's browser (or a deploy-verification request, same mechanism)
    # can silently keep serving a stale build pointing at bundle files that
    # may no longer even exist on the server, for up to a month after every
    # single deploy, real production visitors included, not just this
    # verification script.
    ExpiresByType text/html "access plus 0 seconds"

    # Hashed JS and CSS bundles - Cache 1 year immutable
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    
    # Images and Media
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Web Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Set Cache-Control header for static assets (exclude service worker sw.js)
    <FilesMatch "\.(css|png|jpg|jpeg|webp|svg|ico|woff2|woff|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "^(?!sw\.js$).*\.js$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Never cache service worker, dynamic API responses, or the SPA's own
    # entry HTML - see the ExpiresByType text/html note above, same root
    # cause. no-cache (not no-store) so a byte-identical unchanged fetch can
    # still 304 cheaply; the point is "always revalidate", not "never cache".
    <FilesMatch "^(sw\.js|router\.php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Response Compression (SITE_PERFORMANCE_OPTIMIZATION_PLAN.md, corrected 15 Aug 2026): the
# plan's own proposal for this used PHP's ob_gzhandler() in database.php instead, which this
# deliberately avoids - that file is require_once'd by nearly every endpoint including ones
# TelescopeLogger's set_exception_handler/register_shutdown_function can still emit output
# from after a fatal error, and stacking that behind an active gzip output buffer is untested
# here. mod_deflate at the Apache layer compresses the exact same responses (including the
# 786KB-gzipped main JS/CSS bundle and every router.php JSON payload) with zero PHP changes
# and zero interaction with the app's own output handling - same result, lower risk.
#
# Deliberately NOT AddOutputFilterByType (confirmed locally 15 Aug 2026: that directive is
# actually implemented by mod_filter, not mod_deflate - with mod_deflate loaded but mod_filter
# not, it throws "Invalid command 'AddOutputFilterByType'" and 500s EVERY request on this
# entire vhost, not just a silent no-compression fallback. Using SetOutputFilter scoped to
# file extension instead needs only mod_deflate itself, so it can't fail this way even if
# mod_filter's availability on the real host is ever in doubt. Static asset extensions cover
# JS/CSS/HTML/SVG; .php covers every router.php JSON response and index.php's HTML - this app
# never returns raw binary from PHP, so compressing all .php output is safe.
<IfModule mod_deflate.c>
    <FilesMatch "\.(js|css|html|xml|svg|json)$">
        SetOutputFilter DEFLATE
    </FilesMatch>
    <FilesMatch "\.php$">
        SetOutputFilter DEFLATE
    </FilesMatch>
</IfModule>