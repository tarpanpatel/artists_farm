<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /artists_farm/

    # Handle tenant/property routing for multi-tenant SaaS
    # e.g., /tenant-slug/property-slug/anything -> /index.php?tenant_slug=tenant-slug&property_slug=property-slug
    # Only rewrites when the full path isn't a real file/directory, so
    # /php/..., /dist/..., /assets/..., /api/... etc. are left untouched
    RewriteCond %{REQUEST_URI} !clean_all_roberts\.php$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z0-9-_]+)/([a-z0-9-_]+)/?(.*)$ index.php?tenant_slug=$1&property_slug=$2 [QSA,L]

    # Fallback for single segment (tenant dashboard)
    RewriteCond %{REQUEST_URI} !clean_all_roberts\.php$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z0-9-_]+)/?(.*)$ index.php?property_slug=$1 [QSA,L]

    # Keep existing rules
    RewriteRule ^food_menu/?$ food_menu.php [L]
</IfModule>

# Browser HTTP Asset Caching (Strategy 1)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # Hashed JS and CSS bundles - Cache 1 year immutable
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    
    # Images and Media
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Web Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Set Cache-Control header for static assets
    <FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|ico|woff2|woff|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # Never cache dynamic API responses
    <FilesMatch "router\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    </FilesMatch>
</IfModule>