# Temp directories
deploylite/

# CRITICAL: local-only deploy dashboard (deploy-panel/) - triggers real
# git/npm/ssh commands on this machine via deploy.ps1. Its localhost-only
# guard (REMOTE_ADDR check) can be defeated by a hosting reverse proxy
# that makes every request look like it came from 127.0.0.1 - this must
# NEVER reach the production server via git pull. Never remove this line.
deploy-panel/

# Tool-generated cache/logs (Playwright MCP console dumps)
.playwright-mcp/

# Not part of this project - unrelated cloned repo used to help other AI tooling
agency-agents/

# Business/market-research doc, not webapp code
AI_MARKET_RESEARCH_PROMPT.md

# Uploaded guest ID documents - real PII, never version-controlled
# (menu/catalog images stay tracked - those are demo content, not guest data)
php/uploads/images/id_documents/

# Uploaded license/certificate documents - real property paperwork, same
# never-version-controlled treatment as guest ID docs above.
php/uploads/documents/*/
!php/uploads/documents/.htaccess

php/database/log.txt

# Custom CSS override (17 Aug 2026) - written directly to disk by
# php/api/configuration.php whenever an admin edits "Custom CSS" on ANY
# environment. Being git-tracked meant every such edit created an
# uncommitted local diff that blocked the next `git pull` on that server
# (see deploy-staging.ps1's Custom-CSS auto-commit step, and the 3 prior
# "chore: sync custom CSS override" commits this caused). The DB
# (system_settings.custom_css) is already the durable backup the app reads
# from - see getSystemSettings() in configuration.php - so each
# environment can keep its own local file without it ever needing to
# round-trip through git again.
assets/css/custom_css_override.css
